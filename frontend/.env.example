# Chave gratuita em https://openrouteservice.org/dev/#/signup
# Com a chave preenchida o app usa o mapa real de Goiânia (MapLibre) e rotas do OpenRouteService.
# Sem chave, roda a cidade fictícia (modo demonstração).
VITE_ORS_API_KEY=

# Opcional: força o modo demonstração mesmo com chave (útil sem internet)
# VITE_MAP_MODE=demo

# Opcional: outro estilo de mapa (precisa ser um style.json do MapLibre)
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
